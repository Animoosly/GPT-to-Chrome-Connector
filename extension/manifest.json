{
  "manifest_version": 3,
  "name": "ChatGPT Chrome Connector",
  "version": "1.2.0",
  "description": "Lets the ChatGPT desktop app read and control this Chrome browser through a local MCP connector.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Chrome Connector",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
